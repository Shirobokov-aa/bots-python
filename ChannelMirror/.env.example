TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me

# my.telegram.org → api_id / api_hash
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# python scripts/telethon_login.py → paste StringSession here
TELEGRAM_SESSION=

DATABASE_URL=sqlite+aiosqlite:///./data/channelmirror.db
ADMIN_TELEGRAM_IDS=123456789

# default ~1.5h between posts per destination
POST_INTERVAL_SECONDS=5400
PUBLISH_TICK_SECONDS=30
ALBUM_WAIT_SECONDS=1.2
MEDIA_DIR=data/media
